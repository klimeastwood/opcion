<Window x:Class="NalogParserWPF.StatusChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📢 Изменения статусов контрагентов" 
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="300" MinWidth="500"
        Background="#E8F4F4"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#1A8B8B"/>
            <Setter Property="Content" Value="✅ Понятно"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="#1A8B8B" 
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,15">
            <Grid>
                <TextBlock Text="📢 ИЗМЕНЕНИЯ СТАТУСОВ КОНТРАГЕНТОВ"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Таблица изменений -->
        <DataGrid x:Name="dgChanges" 
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="White"
                  BorderBrush="#1A8B8B"
                  BorderThickness="1"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="УНП" Binding="{Binding Unp}" Width="120"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding FullName}" Width="*" MinWidth="200"/>
                <DataGridTemplateColumn Header="Было" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OldStatus}" 
                                       Foreground="{Binding OldStatusColor}"
                                       FontWeight="SemiBold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Стало" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NewStatus}" 
                                       Foreground="{Binding NewStatusColor}"
                                       FontWeight="SemiBold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Дата проверки" Binding="{Binding CheckDate}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопка закрытия -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button x:Name="btnClose"
                    Style="{StaticResource CloseButton}"
                    Click="BtnClose_Click"/>
            <TextBlock Text="(или нажмите Esc для закрытия)"
                       FontSize="12"
                       Foreground="#666"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>