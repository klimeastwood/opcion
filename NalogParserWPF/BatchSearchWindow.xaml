<Window x:Class="NalogParserWPF.BatchSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔍 Групповой поиск по УНП" 
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="500" MinWidth="700"
        Background="#E8F4F4"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="SearchButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="#1A8B8B"/>
            <Setter Property="Content" Value="🔍 Начать поиск"/>
        </Style>

        <Style x:Key="ClearButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="#C97B7B"/>
            <Setter Property="Content" Value="🗑️ Очистить"/>
        </Style>

        <Style x:Key="ExportButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="#B87333"/>
            <Setter Property="Content" Value="📄 Экспорт в CSV"/>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="#666"/>
            <Setter Property="Content" Value="✕ Закрыть"/>
        </Style>

        <Style x:Key="LoadButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="#4A7B8B"/>
            <Setter Property="Content" Value="📂 Загрузить из файла"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="#1A8B8B" 
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,15">
            <Grid>
                <TextBlock Text="🔍 ГРУППОВОЙ ПОИСК ПО УНП"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Панель ввода -->
        <Border Grid.Row="1" 
                Padding="10" 
                BorderBrush="#1A8B8B" 
                BorderThickness="1" 
                CornerRadius="5"
                Background="#F0F8F8"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Введите УНП (по одному на строку):" 
                               FontSize="14" 
                               FontWeight="Bold"
                               Foreground="#1A5C5C"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" (поддерживается * и ?)" 
                               FontSize="12"
                               Foreground="#666"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnLoadFile"
                            Style="{StaticResource LoadButton}"
                            Click="BtnLoadFile_Click"/>
                    <Button x:Name="btnClearBatch"
                            Style="{StaticResource ClearButton}"
                            Click="BtnClearBatch_Click"/>
                </StackPanel>

                <TextBox x:Name="txtBatchInput" 
                         Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                         Height="100"
                         FontSize="13"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         BorderBrush="#1A8B8B"
                         BorderThickness="1"
                         ToolTip="Введите УНП по одному на строку. Например:&#x0a;100582333&#x0a;200582334&#x0a;300582335* (с * для частичного поиска)"/>
            </Grid>
        </Border>

        <!-- Результаты -->
        <Border Grid.Row="2" 
                Padding="5" 
                BorderBrush="#1A8B8B" 
                BorderThickness="1" 
                CornerRadius="5"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,5,5,5">
                    <TextBlock x:Name="lblProgress" 
                               Text="Готов к работе. Введите УНП для поиска." 
                               FontSize="13"
                               Foreground="#1A5C5C"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblResultsCount" 
                               FontSize="13"
                               Foreground="#1A5C5C"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblStatus" 
                               FontSize="13"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                </StackPanel>

                <DataGrid x:Name="dgBatchResults" 
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="White"
                          BorderBrush="#1A8B8B"
                          BorderThickness="0"
                          Margin="5"
                          MouseDoubleClick="DgBatchResults_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Index}" Width="50"/>
                        <DataGridTextColumn Header="УНП" Binding="{Binding Unp}" Width="120"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding FullName}" Width="*" MinWidth="200"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding StatusColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Дата проверки" Binding="{Binding CheckDate}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            Margin="5">
                    <Button x:Name="btnBatchSearch"
                            Style="{StaticResource SearchButton}"
                            Click="BtnBatchSearch_Click"/>
                    <Button x:Name="btnExportBatch"
                            Style="{StaticResource ExportButton}"
                            Click="BtnExportBatch_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Кнопка закрытия -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btnClose"
                    Style="{StaticResource CloseButton}"
                    Click="BtnClose_Click"/>
            <TextBlock Text="(или нажмите Esc для закрытия)"
                       FontSize="12"
                       Foreground="#666"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>