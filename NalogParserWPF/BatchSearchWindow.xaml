<Window x:Class="NalogParserWPF.BatchSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NalogParserWPF.Views"
        Title="Поиск по нескольким УНП" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        MinHeight="560" MinWidth="800"
        Background="{DynamicResource WindowBackgroundBrush}"
        AllowDrop="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="MainButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{DynamicResource NeutralButtonBrush}"/>
            <Setter Property="Content" Value="Закрыть"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconCloseTemplate}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:BatchSearchView Grid.Row="0"/>

        <!-- Кнопка закрытия -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btnClose"
                    Style="{StaticResource CloseButton}"
                    Command="{Binding CloseCommand}"/>
            <TextBlock Text="(или нажмите Esc для закрытия)"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
