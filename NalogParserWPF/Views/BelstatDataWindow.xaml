<Window x:Class="NalogParserWPF.Views.BelstatDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NalogParserWPF.Converters"
        Title="Госстатистика — таблица результатов"
        Height="800" Width="1200"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>

        <!-- Кнопки окна наследуют единую систему кнопок приложения (AppButtonBase):
             закругление, состояния наведения/нажатия и «приглушение» кнопки,
             команда которой запрещена (CanExecute = false). -->
        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <Style x:Key="ExportButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Background" Value="{DynamicResource ExportButtonBrush}"/>
        </Style>

        <Style x:Key="DataCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
            <Setter Property="Content" Value="Закрыть"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconCloseTemplate}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка с логотипом -->
            <RowDefinition Height="Auto"/>
            <!-- Заголовок результата -->
            <RowDefinition Height="*" MinHeight="220"/>
            <!-- Таблица значений показателя -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки действий -->
        </Grid.RowDefinitions>

        <!-- Шапка окна: фирменная подпись и логотип, как в главном окне -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Source="/sk-logo-2.png"
                   Width="48" Height="48"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Следственный комитет Республики Беларусь"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextAccentBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Информация из официальных источников"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Opacity="0.85"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Жёлтая линия СК под шапкой окна (фирменный акцент палитры) -->
            <Border Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom"
                    Height="2"
                    Background="{DynamicResource SecondaryBrush}"/>
        </Grid>

        <!-- Заголовок результата: показатель, период и объём выборки -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{Binding ResultTitle}"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextAccentBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ResultSubtitle}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="{Binding ResultRowCount, StringFormat='Строк в таблице: {0}'}"/>
        </StackPanel>

        <!-- Таблица значений показателя занимает всё свободное место окна.
             Колонки строятся автоматически из DataTable, путь привязки переводится
             в индексную форму «[имя колонки]» в code-behind: имена измерений Белстата
             содержат точки и пробелы, которые ломают обычную привязку по имени. -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Фильтр таблицы результата: строка поиска по всем колонкам (измерения Белстата). -->
            <StackPanel Grid.Row="0" Style="{StaticResource TableFilterPanel}">
                <TextBlock Style="{StaticResource TableFilterLabel}" Text="🔎 Фильтр:"/>
                <TextBox x:Name="ResultFilterBox" Style="{StaticResource TableFilterBox}"/>
                <TextBlock Style="{StaticResource TableFilterHint}" Text="поиск по всем колонкам таблицы результата"/>
            </StackPanel>

            <DataGrid x:Name="ResultGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding ResultTable.DefaultView}"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="BelstatDataGrid_AutoGeneratingColumn"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="Cell"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      ToolTip="Двойной клик по ячейке — копировать значение"
                      Visibility="{Binding IsResultVisible, Converter={StaticResource BoolToVis}}"/>

            <Border Grid.Row="1"
                    Padding="16"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Background="{DynamicResource CardBackgroundBrush}"
                    VerticalAlignment="Stretch"
                    Visibility="{Binding IsResultVisible, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                <TextBlock Text="{Binding EmptyResultMessage}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Экспорт текущего результата и закрытие окна. Команды экспорта сами
             запрещают выполнение, если данных нет (CanExecute = HasExportData), —
             так же, как на вкладке «Госстатистика». -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Style="{StaticResource ExportButton}"
                    Content="PDF"
                    ContentTemplate="{StaticResource IconExportPdfTemplate}"
                    Command="{Binding ExportPdfCommand}"
                    ToolTip="Сохранить текущий результат в PDF"/>
            <Button Style="{StaticResource ExportButton}"
                    Content="Excel"
                    ContentTemplate="{StaticResource IconExportExcelTemplate}"
                    Command="{Binding ExportExcelCommand}"
                    ToolTip="Сохранить текущий результат в Excel"/>
            <Button Style="{StaticResource ExportButton}"
                    Content="CSV"
                    ContentTemplate="{StaticResource IconExportCsvTemplate}"
                    Command="{Binding ExportCsvCommand}"
                    ToolTip="Сохранить текущий результат в CSV"/>
            <Button Style="{StaticResource DataCloseButton}"
                    Click="CloseButton_Click"/>
            <TextBlock Text="(или нажмите Esc для закрытия)"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
