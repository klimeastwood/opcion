<UserControl x:Class="NalogParserWPF.Views.BatchSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:NalogParserWPF.ViewModels"
             xmlns:converters="clr-namespace:NalogParserWPF.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="MainButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <Style x:Key="SearchButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Content" Value="Начать поиск"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconSearchTemplate}"/>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
            <Setter Property="Content" Value="Отмена"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconCancelTemplate}"/>
        </Style>

        <Style x:Key="ClearButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
            <Setter Property="Content" Value="Очистить список"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconClearTemplate}"/>
        </Style>

        <Style x:Key="LoadButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
            <Setter Property="Content" Value="Загрузить файл"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconLoadTemplate}"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>

        <Style x:Key="ExportButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{DynamicResource ExportButtonBrush}"/>
            <Setter Property="Content" Value="Экспорт в CSV"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconExportCsvTemplate}"/>
        </Style>

        <Style x:Key="ExportExcelButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{DynamicResource ExcelButtonBrush}"/>
            <Setter Property="Content" Value="Экспорт в Excel"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconExportExcelTemplate}"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>

        <Style x:Key="ExportPdfButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Content" Value="Экспорт в PDF"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconExportPdfTemplate}"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent" AllowDrop="True" DragOver="View_DragOver" Drop="View_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="1" 
                Background="{DynamicResource AccentBrush}" 
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,15">
            <Grid>
                <TextBlock FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource OnAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <InlineUIContainer>
                        <iconPacks:PackIconBootstrapIcons Kind="Search" Width="20" Height="20" Margin="0,0,7,0"/>
                    </InlineUIContainer>
                    <Run Text="ПОИСК ПО НЕСКОЛЬКИМ УНП"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Панель ввода -->
        <Border Grid.Row="2" 
                Padding="10" 
                BorderBrush="{DynamicResource AccentBrush}" 
                BorderThickness="1" 
                CornerRadius="5"
                Background="{DynamicResource PanelBackgroundBrush}"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Список УНП:"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextAccentBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="btnLoadFile"
                            Style="{StaticResource LoadButton}"
                            Command="{Binding LoadFileCommand}"/>
                    <Button x:Name="btnClearBatch"
                            Style="{StaticResource ClearButton}"
                            Command="{Binding ClearCommand}"/>
                </StackPanel>

                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBox x:Name="txtBatchInput" 
                             Text="{Binding InputList, UpdateSourceTrigger=PropertyChanged}"
                             Height="100"
                             FontSize="13"
                             FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             BorderBrush="{DynamicResource AccentBrush}"
                             BorderThickness="1"
                             Padding="4"
                             ToolTip="Введите УНП по одному на строку. Файл можно перетащить в окно (txt, csv, xlsx)."/>
                    <TextBlock Text="Введите УНП (по одному на строку) или загрузите файл"
                               FontSize="13"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtBatchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- Результаты -->
        <Border Grid.Row="3" 
                Padding="5" 
                BorderBrush="{DynamicResource AccentBrush}" 
                BorderThickness="1" 
                CornerRadius="5"
                Background="{DynamicResource CardBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,5,5,5">
                    <TextBlock x:Name="lblProgress" 
                               Text="{Binding ProgressText}"
                               FontSize="13"
                               Foreground="{DynamicResource TextAccentBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock x:Name="lblStatus"
                               Text="{Binding StatusMessage}"
                               FontSize="13"
                               Foreground="{DynamicResource TextAccentBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblPercent"
                               Text="{Binding ProgressValue, StringFormat={}{0:0}%}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <ProgressBar Grid.Row="1"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue}"
                             Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"
                             Margin="5,0,5,5"/>

                <DataGrid x:Name="dgBatchResults" 
                          Grid.Row="2"
                          MouseDoubleClick="DgBatchResults_MouseDoubleClick"
                          ItemsSource="{Binding Results}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="{DynamicResource CardBackgroundBrush}"
                          BorderBrush="{DynamicResource AccentBrush}"
                          BorderThickness="0"
                          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Index}" Width="45"/>
                        <DataGridTextColumn Header="Запрос" Binding="{Binding Query}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Query}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="УНП" Binding="{Binding Unp}" Width="110"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="2*" MinWidth="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="0.8*" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding StatusColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Status}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="1.5*" MinWidth="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Address}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Инспекция" Binding="{Binding Inspection}" Width="1.2*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Inspection}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Дата регистрации" Binding="{Binding RegistrationDate}" Width="110"/>
                        <DataGridTextColumn Header="Дата проверки" Binding="{Binding CheckDate}" Width="120"/>
                        <DataGridTextColumn Header="Ошибка" Binding="{Binding Error}" Width="1.2*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Error}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            Margin="5">
                    <Button x:Name="btnBatchSearch"
                            Style="{StaticResource SearchButton}"
                            Command="{Binding SearchBatchCommand}"/>
                    <Button x:Name="btnCancelSearch"
                            Style="{StaticResource CancelButton}"
                            Command="{Binding CancelSearchCommand}"/>
                    <Button x:Name="btnExportBatch"
                            Style="{StaticResource ExportButton}"
                            Command="{Binding ExportCsvCommand}"/>
                    <Button x:Name="btnExportExcel"
                            Style="{StaticResource ExportExcelButton}"
                            Command="{Binding ExportExcelCommand}"/>
                    <Button x:Name="btnExportPdf"
                            Style="{StaticResource ExportPdfButton}"
                            Command="{Binding ExportPdfCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
