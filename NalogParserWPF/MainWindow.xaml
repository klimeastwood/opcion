<Window x:Class="NalogParserWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NalogParserWPF.Converters"
        Title="Проверка контрагентов по УНП"
        Height="780" Width="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="650" MinWidth="750"
        Background="#E8F4F4">

    <Window.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#1A8B8B"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="#1A8B8B"/>
            <Setter Property="Content" Value="🔍 Поиск"/>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="#C97B7B"/>
            <Setter Property="Content" Value="⏹ Отмена"/>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Background" Value="#D5E8E8"/>
            <Setter Property="Foreground" Value="#1A5C5C"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="4 4 0 0">
                            <ContentPresenter x:Name="ContentSite"
                                      ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                      TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                      TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A8B8B"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="White"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#1A8B8B"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="#1A5C5C"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#C5E0E0"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="#0D4A4A"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#1A8B8B"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="BorderBrush" Value="#1A8B8B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="ToolTip" Value="Введите УНП или ФИО"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Введите УНП или ФИО" Foreground="LightGray" FontSize="14" Margin="10,0,0,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Вкладки -->
        <TabControl Grid.Row="0"
                    TabStripPlacement="Top"
                    Margin="0,0,0,10"
                    Background="#E8F4F4"
                    BorderThickness="0">

            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource TabItemStyle}"/>
            </TabControl.ItemContainerStyle>

            <!-- Вкладка 1: Поиск -->
            <TabItem Header="🔍 Поиск">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Тип поиска -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,15">
                        <TextBlock Text="Кого проверяем:"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1A5C5C"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"/>

                        <ComboBox SelectedValue="{Binding SearchType, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Width="200"
                                  Height="35"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"
                                  Background="White">
                            <ComboBoxItem Content="Организация / ИП" Tag="Legal"/>
                            <ComboBoxItem Content="Физическое лицо" Tag="Physical"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Запрос -->
                    <Border Grid.Row="1"
                            Padding="10"
                            BorderBrush="#1A8B8B"
                            BorderThickness="1"
                            CornerRadius="5"
                            Background="#F0F8F8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="УНП / ФИО:"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#1A5C5C"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource WatermarkTextBox}"/>
                        </Grid>
                    </Border>

                    <!-- Статус и индикатор поиска -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,10">
                        <ProgressBar Height="6"
                                     IsIndeterminate="{Binding IsSearching}"
                                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="14"
                                   Foreground="#1A5C5C"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Кнопки действий -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,5,0,0">
                        <Button Style="{StaticResource SearchButton}"
                                Width="160"
                                Command="{Binding SearchCommand}"/>
                        <Button Style="{StaticResource CancelButton}"
                                Width="160"
                                Command="{Binding CancelSearchCommand}"/>
                    </StackPanel>

                    <!-- Результат -->
                    <Border Grid.Row="4"
                            Margin="0,15,0,0"
                            Padding="10"
                            BorderBrush="#1A8B8B"
                            BorderThickness="1"
                            CornerRadius="5"
                            Background="White">
                        <TextBox Text="{Binding CurrentResult.Row.FullName, Mode=OneWay}"
                                 FontSize="14"
                                 Padding="15"
                                 Background="White"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: История -->
            <TabItem Header="📋 История">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>

                    <!-- Таблица истории -->
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding HistoryItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Background="White"
                              BorderBrush="#1A8B8B"
                              BorderThickness="1"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="УНП" Binding="{Binding Unp}" Width="110"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding FullName}" Width="*" MinWidth="150"/>
                            <DataGridTemplateColumn Header="Статус" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                CornerRadius="3"
                                                Padding="6,3"
                                                Margin="2">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Дата" Binding="{Binding SearchDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                            <DataGridTemplateColumn Header="Действия" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="🔁 Повторить"
                                                    FontSize="12"
                                                    Padding="8,3"
                                                    Margin="0,0,5,0"
                                                    Command="{Binding DataContext.RepeatSearchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="👁 Просмотр"
                                                    FontSize="12"
                                                    Padding="8,3"
                                                    Command="{Binding DataContext.ViewHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Кнопка очистки истории -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🗑️ Очистить всё"
                                Style="{StaticResource MainButton}"
                                Background="#C97B7B"
                                Width="140"
                                Height="35"
                                Command="{Binding ClearHistoryCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
