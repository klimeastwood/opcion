<Window x:Class="NalogParserWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:NalogParserWPF.ViewModels"
        xmlns:converters="clr-namespace:NalogParserWPF.Converters"
        xmlns:helpers="clr-namespace:NalogParserWPF.Helpers"
        xmlns:views="clr-namespace:NalogParserWPF.Views"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="ОПЦИОН"
        Height="900" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized"
        ResizeMode="CanResize"
        MinHeight="700" MinWidth="1000"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="MainButton" TargetType="Button" BasedOn="{StaticResource AccentButton}"/>

        <Style x:Key="SearchButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Content" Value="Поиск"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconSearchTemplate}"/>
        </Style>

        <!-- Переключатель режима вкладки «Курсы валют»: плитка с чёткой подписью.
             Активный режим подсвечивается акцентным цветом, наведение слегка приглушает. -->
        <Style x:Key="ModeToggleButton" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4 4 0 0">
                            <!-- Цвет заголовка вкладки задаётся на уровне самого TabItem
                                 (см. Style.Triggers ниже этого шаблона). Заголовок — это StackPanel
                                 (иконка + текст) с логическим родителем TabItem, поэтому наследуемый
                                 Foreground берётся от TabItem, а сеттеры ContentSite внутри шаблона
                                 до содержимого заголовка не доходят. -->
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <!-- Жёлтая полоса СК под активной вкладкой: видна и на светлой, и на тёмной теме -->
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <!-- ВАЖНО: цвет заголовка вкладки задаётся на уровне самого TabItem, а не внутри шаблона.
                 Заголовок — это StackPanel (иконка + текст) с логическим родителем TabItem,
                 поэтому наследуемый Foreground берётся от TabItem, и сеттеры ContentSite
                 внутри ControlTemplate до содержимого заголовка не доходят.
                 Результат: активная вкладка = тёмно-синий фон + белый текст/иконка (OnAccentBrush),
                 и заголовок виден и на светлой, и на тёмной теме. -->
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TabHoverForegroundBrush}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WatermarkComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="8,0,10,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="ToolTip" Value="Введите УНП (9 цифр) или выберите из истории поиска"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Введите УНП (9 цифр)" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="10,0,0,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Поле поиска по справочнику валют вкладки «Курсы валют»: подсказка-плейсхолдер
             (триггер на пустой Text) и наглядная акцентная рамка. -->
        <Style x:Key="CurrencySearchTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="ToolTip" Value="Введите код валюты (USD, EUR, RUB) или часть названия. Например: 'доллар', 'USD'"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Введите код валюты (USD, EUR) или название" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="10,0,0,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Поле поиска по каталогу показателей вкладки «Госстатистика»: подсказка-плейсхолдер
             (триггер на пустой Text) и наглядная акцентная рамка. -->
        <Style x:Key="BelstatSearchTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="380"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="ToolTip" Value="Введите часть названия или код показателя. Например: 'инфляция', '10103000003'"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Название или код показателя" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="10,0,0,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="107*"/>
            <ColumnDefinition Width="753*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки управления -->
            <RowDefinition Height="*"/>
            <!-- Вкладки -->
            <RowDefinition Height="Auto"/>
            <!-- Футер -->
        </Grid.RowDefinitions>

        <!-- Шапка приложения с логотипом -->
        <Grid Grid.Row="0" Margin="0,0,0,12" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Source="sk-logo-2.png"
                   Width="64" Height="64"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   Margin="0,0,14,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Следственный комитет Республики Беларусь"
                           Style="{StaticResource AppTitleText}"/>
                <TextBlock Text="Информация из официальных источников"
                           Style="{StaticResource AppSubtitleText}"/>
            </StackPanel>

            <!-- Кнопки управления в шапке -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Настройки"
                        ContentTemplate="{StaticResource IconSettingsTemplate}"
                        ToolTip="Настройки"
                        Style="{StaticResource MainButton}"
                        MinWidth="40"
                        Height="40"
                        Margin="0,0,4,0"
                        Padding="8,6"
                        Command="{Binding OpenSettingsCommand}"/>
                <Button Content="О программе"
                        ContentTemplate="{StaticResource IconInfoTemplate}"
                        ToolTip="О программе"
                        Style="{StaticResource MainButton}"
                        MinWidth="40"
                        Height="40"
                        Margin="0,0,0,0"
                        Padding="8,6"
                        Command="{Binding OpenAboutCommand}"/>
            </StackPanel>

            <!-- Жёлтая линия СК под шапкой приложения (фирменный акцент палитры) -->
            <Border Grid.ColumnSpan="3"
                    VerticalAlignment="Bottom"
                    Height="2"
                    Background="{DynamicResource SecondaryBrush}"/>
        </Grid>

        <!-- Вкладки -->
        <TabControl Grid.Row="2"
                    TabStripPlacement="Top"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderThickness="0" Grid.ColumnSpan="2" Margin="0">

            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource TabItemStyle}"/>
            </TabControl.ItemContainerStyle>

            <!-- Вкладка 1: Поиск -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="Search" Margin="0,0,6,0"/>
                        <TextBlock Text="Поиск по УНП" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Запрос -->
                    <Border Grid.Row="0"
                            Padding="10"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Background="{DynamicResource PanelBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="УНП (9 цифр):"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextAccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <ComboBox Grid.Column="1"
                                      x:Name="UnpComboBox"
                                      ItemsSource="{Binding SearchHistorySuggestions}"
                                      Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource WatermarkComboBox}"
                                      KeyDown="UnpComboBox_KeyDown"
                                      DropDownClosed="UnpComboBox_DropDownClosed"/>
                        </Grid>
                    </Border>

                    <!-- Статус и индикатор поиска -->
                    <StackPanel Grid.Row="1" Margin="0,10,0,10">
                        <ProgressBar Height="6"
                                     IsIndeterminate="{Binding IsSearching}"
                                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextAccentBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Кнопка поиска. Отдельная кнопка отмены поиска по УНП убрана:
                         запрос выполняется быстро, а отмена осталась только в массовом поиске. -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,5,0,0">
                        <Button Style="{StaticResource SearchButton}"
                                Width="160"
                                Command="{Binding SearchCommand}"/>
                    </StackPanel>

                    <!-- Результат -->
                    <Border Grid.Row="3"
        Margin="0,15,0,0"
        Padding="10"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="1"
        CornerRadius="5"
        Background="{DynamicResource CardBackgroundBrush}"
        Visibility="{Binding CurrentCompany, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Панель управления отображением -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Переключатель «Кратко / Подробно»: стиль ModeToggleButton красит активное
                                     состояние акцентным цветом (без него ToggleButton выглядел как серая кнопка). -->
                                <ToggleButton Grid.Column="0"
                                              Style="{StaticResource ModeToggleButton}"
                                              IsChecked="{Binding IsDetailedView}"
                                              Content="Кратко / Подробно"
                                              ContentTemplate="{StaticResource IconDetailsTemplate}"
                                              Margin="0,0,15,0"
                                              ToolTip="Подробно — полная карточка организации; Кратко — только наименование"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Экспорт в PDF"
                                ContentTemplate="{StaticResource IconExportPdfTemplate}"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{DynamicResource OnAccentBrush}"
                        Background="{DynamicResource ExportButtonBrush}"
                        BorderThickness="0"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Command="{Binding ExportPdfCommand}"/>
                                    <Button Content="Копировать"
                                ContentTemplate="{StaticResource IconCopyTemplate}"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{DynamicResource OnAccentBrush}"
                        Background="{DynamicResource SecondaryButtonBrush}"
                        BorderThickness="0"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Command="{Binding CopyResultCommand}"/>
                                    <!-- Очистка результата: сбрасывает карточку организации и поле УНП. -->
                                    <Button Content="Очистить"
                                ContentTemplate="{StaticResource IconClearTemplate}"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{DynamicResource OnAccentBrush}"
                        Background="{DynamicResource DangerSoftBrush}"
                        BorderThickness="0"
                        Padding="12,6"
                        Margin="0"
                        Cursor="Hand"
                        ToolTip="Скрыть результат поиска и очистить поле УНП"
                        Command="{Binding ClearResultCommand}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Краткий вид: только название -->
                            <Border Grid.Row="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                CornerRadius="5"
                Padding="12"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                Visibility="{Binding IsDetailedView, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentCompany.FullName}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextAccentBrush}"
                       TextWrapping="Wrap"/>
                            </Border>

                            <!-- Подробный вид: полная информация -->
                            <Grid Grid.Row="1"
              Visibility="{Binding IsDetailedView, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="УНП:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentCompany.Unp}" Style="{StaticResource DetailValue}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Полное наименование:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentCompany.FullName}" Style="{StaticResource DetailValue}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Краткое наименование:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentCompany.ShortName}" Style="{StaticResource DetailValue}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Адрес:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentCompany.Address}" Style="{StaticResource DetailValue}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата регистрации:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentCompany.RegistrationDate}" Style="{StaticResource DetailValue}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Инспекция МНС:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}">
                <Run Text="{Binding CurrentCompany.InspectionName, Mode=OneWay}"/>
                <Run Text=" (код "/>
                <Run Text="{Binding CurrentCompany.InspectionCode, Mode=OneWay}"/>
                <Run Text=")"/>
                                </TextBlock>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Статус:" Style="{StaticResource DetailLabel}"/>
                                <Border Grid.Row="6" Grid.Column="1"
                    HorizontalAlignment="Left"
                    Background="{Binding CurrentCompany.Status, Converter={StaticResource StatusToBrushConverter}}"
                    CornerRadius="3"
                    Padding="12,4">
                                    <TextBlock Text="{Binding CurrentCompany.Status}"
                           Foreground="{DynamicResource OnAccentBrush}"
                           FontWeight="SemiBold"
                           FontSize="14"/>
                                </Border>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Дата изменения статуса:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CurrentCompany.StatusChangeDate}" Style="{StaticResource DetailValue}"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Дата ликвидации:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding CurrentCompany.LiquidationDate}" Style="{StaticResource DetailValue}"/>
                            </Grid>
                        </Grid>

                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Массовый поиск по УНП -->
            <!-- Вкладка 3: История проверок УНП -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="ClipboardData" Margin="0,0,6,0"/>
                        <TextBlock Text="Массовый поиск" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource AppSubtitleText}"
                               Text="Пакетная проверка списка УНП: вставьте список вручную, загрузите файл (.txt, .csv, .xlsx) или перетащите его в окно. Результаты можно экспортировать в CSV, Excel и PDF."
                               Margin="0,0,0,8"/>

                    <views:BatchSearchView Grid.Row="1"
                                           DataContext="{Binding BatchSearch}"/>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="JournalText" Margin="0,0,6,0"/>
                        <TextBlock Text="История проверок УНП" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Панель фильтра таблицы истории -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Статус проверки -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <ProgressBar Height="6"
                                     IsIndeterminate="{Binding IsChecking}"
                                     Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding CheckStatus}"
                                   FontSize="12"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Таблица истории. SelectionMode=Extended — выделение нескольких записей
                         (Ctrl/Shift) для массового удаления кнопкой «Удалить выделенные». -->
                    <!-- Фильтр таблицы истории: поиск идёт одновременно по всем колонкам
                         (УНП, наименование, статус, адрес, даты). -->
                    <StackPanel Grid.Row="1" Style="{StaticResource TableFilterPanel}">
                        <TextBlock Style="{StaticResource TableFilterLabel}" Text="🔎 Фильтр:"/>
                        <TextBox x:Name="HistoryFilterBox" Style="{StaticResource TableFilterBox}"/>
                        <TextBlock Style="{StaticResource TableFilterHint}" Text="поиск по всем колонкам таблицы истории"/>
                    </StackPanel>

                    <DataGrid x:Name="HistoryGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding HistoryItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              SelectionChanged="HistoryGrid_SelectionChanged"
                              Background="{DynamicResource CardBackgroundBrush}"
                              BorderBrush="{DynamicResource AccentBrush}"
                              BorderThickness="1"
                              Margin="0,0,0,10"
                              MouseDoubleClick="HistoryGrid_MouseDoubleClick"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ToolTip="Двойной клик по ячейке — копировать значение; Ctrl/Shift — выделить несколько записей">
                        <!-- Контекстное меню выделенной строки: операции с записью истории. -->
                        <DataGrid.ContextMenu>
                            <!-- ContextMenu отображается в отдельном дереве (Popup), поэтому
                                 доступ к DataGrid идёт через PlacementTarget, а не через
                                 x:Reference: ссылка на сам DataGrid внутри его же свойства даёт
                                 циклическую зависимость MarkupExtension при загрузке разметки. -->
                            <ContextMenu>
                                <MenuItem Header="Просмотр записи"
                                          Command="{Binding Path=PlacementTarget.DataContext.ViewHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding Path=PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Повторить поиск"
                                          Command="{Binding Path=PlacementTarget.DataContext.RepeatSearchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding Path=PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Удалить запись"
                                          Command="{Binding Path=PlacementTarget.DataContext.DeleteHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding Path=PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdateInfo}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HighlightBackgroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="Auto" MinWidth="45"/>
                            <DataGridTextColumn Header="УНП" Binding="{Binding Unp}" Width="*" MinWidth="100"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="3*" MinWidth="150"/>
                            <DataGridTemplateColumn Width="*" MinWidth="100">
                                <!-- Легенда статусов проверки УНП — в подсказке заголовка колонки. -->
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Статус"
                                               ToolTip="{x:Static helpers:StatusHelper.StatusLegend}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                CornerRadius="3"
                                                Padding="6,3"
                                                Margin="2"
                                                VerticalAlignment="Center">
                                            <!-- Правый клик по плашке — легенда статусов проверки УНП. -->
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Действующий — организация зарегистрирована и действует"
                                                              IsEnabled="False"/>
                                                    <MenuItem Header="Ликвидирован — деятельность прекращена, исключён из ЕГР"
                                                              IsEnabled="False"/>
                                                    <MenuItem Header="В процессе ликвидации — процедура не завершена"
                                                              IsEnabled="False"/>
                                                    <Separator/>
                                                    <MenuItem IsEnabled="False"
                                                              Header="{Binding Status, StringFormat=Текущий статус: {0}}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{DynamicResource OnAccentBrush}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StatusHint}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Дата проверки" Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="*" MinWidth="120"/>
                            <DataGridTemplateColumn Header="Обновление" Width="*" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UpdateInfo}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource WarningTextBrush}"
                                                   ToolTip="{Binding UpdateInfo}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Действия: компактные кнопки-иконки без подписи. Размер и центрирование берутся из стиля
                                 IconButton (MinWidth=0, 28x28), иначе кнопка растягивалась в пустой синий прямоугольник. -->
                            <DataGridTemplateColumn Header="Действия" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Повторить поиск"
                                                    ContentTemplate="{StaticResource IconRepeatOnlyTemplate}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTip="Повторить поиск"
                                                    Command="{Binding DataContext.RepeatSearchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Просмотр записи"
                                                    ContentTemplate="{StaticResource IconViewOnlyTemplate}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTip="Просмотр деталей"
                                                    Command="{Binding DataContext.ViewHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Удалить запись"
                                                    ContentTemplate="{StaticResource IconDeleteOnlyTemplate}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTip="Удалить запись из истории"
                                                    Command="{Binding DataContext.DeleteHistoryItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Кнопки действий с историей -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,0">
                        <Button Content="Проверить все"
                                ContentTemplate="{StaticResource IconRefreshTemplate}"
                                Style="{StaticResource AccentButton}"
                                Padding="12,6"
                                Margin="4,2"
                                Command="{Binding CheckAllCommand}"/>
                        <Button Content="Очистить всё"
                                ContentTemplate="{StaticResource IconClearTemplate}"
                                Style="{StaticResource MainButton}"
                                Background="{DynamicResource DangerSoftBrush}"
                                Padding="12,6"
                                Margin="4,2"
                                Command="{Binding ClearHistoryCommand}"/>
                        <Button Content="Удалить выделенные"
                                ContentTemplate="{StaticResource IconDeleteOnlyTemplate}"
                                Style="{StaticResource MainButton}"
                                Background="{DynamicResource DangerSoftBrush}"
                                Padding="12,6"
                                Margin="4,2"
                                Command="{Binding DeleteSelectedCommand}"
                                ToolTip="Удалить выделенные записи истории (Ctrl/Shift — выделение нескольких строк)"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Курсы валют -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="CurrencyExchange" Margin="0,0,6,0"/>
                        <TextBlock Text="Курсы валют" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="10"
                      DataContext="{Binding ExchangeRates}"
                      Loaded="ExchangeRatesTab_Loaded">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="500"/>
                    </Grid.ColumnDefinitions>

                    <!-- Параметры запроса и результат -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Режим запроса -->
                        <Border Grid.Row="0"
                                Padding="10"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Background="{DynamicResource PanelBackgroundBrush}">
                            <StackPanel>
                                <TextBlock Text="Режим запроса курсов"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextAccentBrush}"
                                           Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Content="Курс одной валюты"
                                                  ContentTemplate="{StaticResource IconCurrencyTemplate}"
                                                  Style="{StaticResource ModeToggleButton}"
                                                  IsChecked="{Binding IsSingleRateMode}"/>
                                    <ToggleButton Content="Все валюты на дату"
                                                  ContentTemplate="{StaticResource IconListTemplate}"
                                                  Style="{StaticResource ModeToggleButton}"
                                                  IsChecked="{Binding IsAllRatesMode}"/>
                                    <ToggleButton Content="Динамика за период"
                                                  ContentTemplate="{StaticResource IconGraphTemplate}"
                                                  Style="{StaticResource ModeToggleButton}"
                                                  IsChecked="{Binding IsDynamicsMode}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Параметры запроса -->
                        <Border Grid.Row="1"
                                Margin="0,10,0,0"
                                Padding="10"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Background="{DynamicResource CardBackgroundBrush}">
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsCurrencySelectorVisible, Converter={StaticResource BoolToVis}}">
                                    <!-- Отдельное поле фильтрации списка валют -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0">
                                            <InlineUIContainer>
                                                <iconPacks:PackIconBootstrapIcons Kind="Search" Margin="0,0,4,0"/>
                                            </InlineUIContainer>
                                            <Run Text="Поиск валюты:"/>
                                        </TextBlock>
                                        <TextBox Style="{StaticResource CurrencySearchTextBox}"
                                                 Text="{Binding CurrencyFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="CurrencySearchBox_KeyDown"/>
                                        <Button Content="Найти"
                                                Command="{Binding ApplyCurrencyFilterCommand}"
                                                Style="{StaticResource SearchButton}"
                                                Height="32"
                                                MinWidth="100"
                                                Margin="8,0,0,0"
                                                ToolTip="Применить фильтр по введённому коду или названию валюты"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Валюта НБ РБ:"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <ComboBox Width="300"
                                                  ItemsSource="{Binding FilteredCurrencies}"
                                                  SelectedItem="{Binding SelectedCurrency}"
                                                  DisplayMemberPath="DisplayName"
                                                  TextSearch.TextPath="DisplayName"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"/>
                                        <TextBlock Text="{Binding SelectedCurrencyLabel}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsPeriodSelectorVisible, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                        <TextBlock Text="Дата курса:"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <DatePicker SelectedDate="{Binding SelectedDate}" MinWidth="180" MinHeight="32" Language="ru-RU"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsPeriodSelectorVisible, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Период с:"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <DatePicker SelectedDate="{Binding StartDate}" MinWidth="180" MinHeight="32" Language="ru-RU"/>
                                        <TextBlock Text="по:"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,8,0"/>
                                        <DatePicker SelectedDate="{Binding EndDate}" MinWidth="180" MinHeight="32" Language="ru-RU"/>
                                    </StackPanel>

                                    <Button Content="Справочник валют"
                                ContentTemplate="{StaticResource IconBookTemplate}"
                                            Command="{Binding LoadCurrenciesCommand}"
                                            Height="28"
                                            MinWidth="150"
                                            FontSize="12"
                                            Padding="10,2"
                                            Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Кнопки действий -->
                        <WrapPanel Grid.Row="2"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0">
                            <Button Style="{StaticResource AccentButton}"
                                    Content="Получить курс"
                                            ContentTemplate="{StaticResource IconCurrencyTemplate}"
                                    MinWidth="170"
                                    Command="{Binding LoadSingleRateCommand}"
                                    Visibility="{Binding IsSingleRateMode, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource AccentButton}"
                                    Content="Получить все курсы"
                                            ContentTemplate="{StaticResource IconListTemplate}"
                                    MinWidth="170"
                                    Command="{Binding LoadAllRatesCommand}"
                                    Visibility="{Binding IsAllRatesMode, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource AccentButton}"
                                    Content="Получить динамику"
                                            ContentTemplate="{StaticResource IconGraphTemplate}"
                                    MinWidth="170"
                                    Command="{Binding LoadDynamicsCommand}"
                                    Visibility="{Binding IsDynamicsMode, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource MainButton}"
                                    Background="{DynamicResource ExportButtonBrush}"
                                    Content="PDF"
                                            ContentTemplate="{StaticResource IconExportPdfTemplate}"
                                    MinWidth="100"
                                    Padding="8,4"
                                    Command="{Binding ExportPdfCommand}"
                                    ToolTip="Экспорт текущего результата в PDF"/>
                            <Button Style="{StaticResource MainButton}"
                                    Background="{DynamicResource ExcelButtonBrush}"
                                    Content="Excel"
                                            ContentTemplate="{StaticResource IconExportExcelTemplate}"
                                    MinWidth="100"
                                    Padding="8,4"
                                    Command="{Binding ExportExcelCommand}"
                                    ToolTip="Экспорт текущего результата в Excel"/>
                            <Button Style="{StaticResource MainButton}"
                                    Background="{DynamicResource SecondaryButtonBrush}"
                                    Content="CSV"
                                            ContentTemplate="{StaticResource IconExportCsvTemplate}"
                                    MinWidth="100"
                                    Padding="8,4"
                                    Command="{Binding ExportCsvCommand}"
                                    ToolTip="Экспорт текущего результата в CSV"/>
                        </WrapPanel>

                        <!-- Прогресс и статус -->
                        <StackPanel Grid.Row="3" Margin="0,10,0,5">
                            <ProgressBar Height="6"
                                         IsIndeterminate="{Binding IsLoading}"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextAccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                        <!-- Результаты -->
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Фильтр таблицы «Курсы всех валют на дату» -->
                            <StackPanel Grid.Row="0"
                                        Style="{StaticResource TableFilterPanel}"
                                        Visibility="{Binding IsAllRatesResultVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource TableFilterLabel}" Text="🔎 Фильтр:"/>
                                <TextBox x:Name="AllRatesFilterBox" Style="{StaticResource TableFilterBox}"/>
                                <TextBlock Style="{StaticResource TableFilterHint}" Text="поиск по коду и наименованию валюты"/>
                            </StackPanel>

                            <!-- Фильтр таблицы «Динамика курса за период» -->
                            <StackPanel Grid.Row="0"
                                        Style="{StaticResource TableFilterPanel}"
                                        Visibility="{Binding IsDynamicsResultVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource TableFilterLabel}" Text="🔎 Фильтр:"/>
                                <TextBox x:Name="DynamicsFilterBox" Style="{StaticResource TableFilterBox}"/>
                                <TextBlock Style="{StaticResource TableFilterHint}" Text="поиск по дате и курсу"/>
                            </StackPanel>

                            <!-- Курс одной валюты на дату: плашка занимает и строку фильтра -->
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Padding="12"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    Visibility="{Binding IsSingleRateResultVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Официальный курс Национального банка Республики Беларусь"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextAccentBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding CurrentRateCaption}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Код валюты:" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentRate.Cur_Abbreviation}" Style="{StaticResource DetailValue}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование:" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentRate.Cur_Name}" Style="{StaticResource DetailValue}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата:" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentRate.Date, StringFormat={}{0:dd.MM.yyyy}}" Style="{StaticResource DetailValue}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Масштаб (ед.):" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentRate.Cur_Scale}" Style="{StaticResource DetailValue}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Официальный курс, BYN:" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentRate.Cur_OfficialRate, StringFormat={}{0:0.0000}}" Style="{StaticResource DetailValue}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Курсы всех валют на дату -->
                            <DataGrid x:Name="AllRatesGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding AllRatesOnDate}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                                      ToolTip="Двойной клик по ячейке — копировать значение"
                                      Visibility="{Binding IsAllRatesResultVisible, Converter={StaticResource BoolToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Код" Binding="{Binding Cur_Abbreviation}" Width="80"/>
                                    <DataGridTextColumn Header="Наименование валюты" Binding="{Binding Cur_Name}" Width="*"/>
                                    <DataGridTextColumn Header="Масштаб, ед." Binding="{Binding Cur_Scale}" Width="100"/>
                                    <DataGridTextColumn Header="Курс, BYN" Binding="{Binding Cur_OfficialRate, StringFormat={}{0:0.0000}}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Динамика курса за период -->
                            <DataGrid x:Name="DynamicsGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding Dynamics}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                                      ToolTip="Двойной клик по ячейке — копировать значение"
                                      Visibility="{Binding IsDynamicsResultVisible, Converter={StaticResource BoolToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="150"/>
                                    <DataGridTextColumn Header="Курс, BYN" Binding="{Binding Cur_OfficialRate, StringFormat={}{0:0.0000}}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                    <!-- История выполненных запросов курсов -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="10"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Background="{DynamicResource PanelBackgroundBrush}">
                            <StackPanel>
                                <TextBlock Text="История запросов курсов"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextAccentBrush}"/>
                                <TextBlock Text="Сохранённые курсы НБ РБ (локальная база)"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,8,0,0"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Background="{DynamicResource CardBackgroundBrush}">
                            <ListBox ItemsSource="{Binding HistoryItems}"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CurrencyCode}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextAccentBrush}"/>
                                                <TextBlock Text="{Binding Rate, StringFormat={}{0:0.0000}}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Margin="8,0,0,0"/>
                                                <TextBlock Text="BYN"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CurrencyName}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Button Grid.Row="2"
                                Content="Очистить историю"
                                    ContentTemplate="{StaticResource IconClearTemplate}"
                                Style="{StaticResource MainButton}"
                                Background="{DynamicResource DangerSoftBrush}"
                                Padding="12,6"
                                Margin="4,8,4,0"
                                Command="{Binding ClearHistoryCommand}"/>
                    </Grid>
                </Grid>
            </TabItem>
            <!-- Вкладка «Госстатистика»: запросы к публичному API Белстата
                 (каталог рубрик → показатели → ряд значений за период) с историей запросов. -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBootstrapIcons Kind="BarChartLine" Margin="0,0,6,0"/>
                        <TextBlock Text="Госстатистика" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="10"
                      DataContext="{Binding Belstat}"
                      Loaded="BelstatTab_Loaded">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="500"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка: параметры запроса и результат -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <!-- Строки: 0 — каталог показателей, 1 — разделитель высоты,
                             2 — период и действия, 3 — индикатор загрузки и статус,
                             4 — заголовок результата, 5 — таблица результатов.
                             Строка каталога задана Height="Auto" (по содержимому);
                             при перетаскивании разделителя она становится фиксированной,
                             а освободившаяся высота уходит таблице результатов (строка «*»). -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="96"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="220"/>
                        </Grid.RowDefinitions>

                        <!-- Каталог показателей Белстата -->
                        <Border Grid.Row="0"
                                Padding="10"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Background="{DynamicResource PanelBackgroundBrush}">
                            <!-- Прокрутка: разделитель высоты может сжать каталог сильнее,
                                 чем его содержимое, — тогда поля и списки каталога
                                 остаются доступными через полосу прокрутки. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Каталог государственной статистики (API Белстата)"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextAccentBrush}"
                                               Margin="0,0,0,6"/>

                                    <!-- Выбор рубрики каталога -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Рубрика:"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <ComboBox Width="420"
                                                  ItemsSource="{Binding FilteredRubricsView}"
                                                  SelectedItem="{Binding SelectedRubric}"
                                                  DisplayMemberPath="DisplayName"
                                                  TextSearch.TextPath="DisplayName"
                                                  IsTextSearchEnabled="True"
                                                  MaxDropDownHeight="320"
                                                  ToolTip="Тематический раздел каталога; список сужается по строке поиска, выбор рубрики подгружает её показатели"/>
                                        <Button Content="Обновить дерево"
                                                ContentTemplate="{StaticResource IconRefreshTemplate}"
                                                Style="{StaticResource MainButton}"
                                                Height="28"
                                                MinWidth="150"
                                                FontSize="12"
                                                Padding="10,2"
                                                Margin="10,0,0,0"
                                                Command="{Binding LoadRubricsCommand}"
                                                ToolTip="Перезагрузить дерево рубрик каталога Белстата"/>
                                    </StackPanel>

                                    <!-- Поиск показателя по каталогу -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Поиск показателя:"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBox Style="{StaticResource BelstatSearchTextBox}"
                                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="BelstatSearchBox_KeyDown"/>
                                        <Button Content="Найти"
                                                Style="{StaticResource SearchButton}"
                                                Height="32"
                                                MinWidth="100"
                                                Margin="8,0,0,0"
                                                Command="{Binding SearchIndicatorsCommand}"
                                                ToolTip="Поиск показателей по названию или коду (Enter — выполнить поиск; при отсутствии точных совпадений подбираются похожие)"/>
                                        <Button Content="Очистить"
                                                ContentTemplate="{StaticResource IconClearTemplate}"
                                                Style="{StaticResource MainButton}"
                                                Background="{DynamicResource DangerSoftBrush}"
                                                Height="32"
                                                MinWidth="110"
                                                Margin="8,0,0,0"
                                                Command="{Binding ClearSearchCommand}"
                                                ToolTip="Сбросить поисковый запрос и показать показатели выбранной рубрики"/>
                                    </StackPanel>

                                    <!-- Выпадающий список результатов «живого» поиска (первые 20 совпадений).
                                         Выбор строки подставляет рубрику и показатель в поля выше. -->
                                    <ListBox ItemsSource="{Binding FilteredIndicatorsView}"
                                             SelectedItem="{Binding SelectedSearchResult}"
                                             MaxHeight="180"
                                             Margin="0,6,0,0"
                                             Padding="2"
                                             Background="{DynamicResource CardBackgroundBrush}"
                                             BorderBrush="{DynamicResource AccentBrush}"
                                             BorderThickness="1"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}}"
                                             ToolTip="Результаты поиска показателей. Выбор строки подставит рубрику и показатель">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,1">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Code}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Показатель рубрики или результаты поиска по каталогу -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Показатель:"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextAccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <ComboBox Width="620"
                                                  ItemsSource="{Binding Indicators}"
                                                  SelectedItem="{Binding SelectedIndicator}"
                                                  DisplayMemberPath="DisplayName"
                                                  TextSearch.TextPath="DisplayName"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  MaxDropDownHeight="320"
                                                  ToolTip="Показатель ряда данных; если не выбран — запрашиваются значения всех показателей рубрики"/>
                                    </StackPanel>

                                    <!-- Текстовые пояснения к выбору (используются в заголовке результата) -->
                                    <TextBlock Text="{Binding SelectedRubricLabel}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding SelectedIndicatorLabel}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Разделитель высоты. Строка каталога задана Height="Auto", поэтому
                             разделитель тянет именно её: вверх — каталог сжимается и таблица
                             результатов становится выше, вниз — наоборот. Значения строки
                             ограничены MinHeight (каталог — 96, таблица — 220). -->
                        <GridSplitter Grid.Row="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      Background="{DynamicResource BorderBrush}"
                                      ShowsPreview="False"
                                      Cursor="SizeNS"
                                      ToolTip="Потяните, чтобы изменить высоту каталога показателей и таблицы результатов"/>

                        <!-- Период запроса и действия. Кнопки не задают IsEnabled явно:
                             команды ViewModel сами запрещают выполнение через CanExecute
                             (!IsLoading / HasSelection / HasExportData). -->
                        <Border Grid.Row="2"
                                Margin="0,10,0,0"
                                Padding="10"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Background="{DynamicResource CardBackgroundBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Период с"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextAccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox Width="110"
                                              ItemsSource="{Binding AvailableYears}"
                                              SelectedItem="{Binding FirstYear}"
                                              MaxDropDownHeight="260"
                                              ToolTip="Первый год периода выборки"/>
                                    <TextBlock Text="по"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextAccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,8,0"/>
                                    <ComboBox Width="110"
                                              ItemsSource="{Binding AvailableYears}"
                                              SelectedItem="{Binding LastYear}"
                                              MaxDropDownHeight="260"
                                              ToolTip="Последний год периода выборки"/>
                                </StackPanel>

                                <!-- Действия: запрос к API, отмена, экспорт результата -->
                                <WrapPanel Orientation="Horizontal"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0">
                                    <Button Style="{StaticResource AccentButton}"
                                            Content="Получить данные"
                                            ContentTemplate="{StaticResource IconChartTemplate}"
                                            MinWidth="170"
                                            Command="{Binding LoadDataCommand}"
                                            ToolTip="Загрузить значения выбранного показателя из API Белстата"/>
                                    <Button Style="{StaticResource MainButton}"
                                            Content="Отмена"
                                            ContentTemplate="{StaticResource IconCancelTemplate}"
                                            Background="{DynamicResource DangerSoftBrush}"
                                            MinWidth="110"
                                            Padding="8,4"
                                            Command="{Binding CancelCommand}"
                                            ToolTip="Прервать текущий запрос к API"/>
                                    <Button Style="{StaticResource MainButton}"
                                            Content="PDF"
                                            ContentTemplate="{StaticResource IconExportPdfTemplate}"
                                            Background="{DynamicResource ExportButtonBrush}"
                                            MinWidth="95"
                                            Padding="8,4"
                                            Command="{Binding ExportPdfCommand}"
                                            ToolTip="Сохранить текущий результат в PDF"/>
                                    <Button Style="{StaticResource MainButton}"
                                            Content="Excel"
                                            ContentTemplate="{StaticResource IconExportExcelTemplate}"
                                            Background="{DynamicResource ExportButtonBrush}"
                                            MinWidth="95"
                                            Padding="8,4"
                                            Command="{Binding ExportExcelCommand}"
                                            ToolTip="Сохранить текущий результат в Excel"/>
                                    <Button Style="{StaticResource MainButton}"
                                            Content="CSV"
                                            ContentTemplate="{StaticResource IconExportCsvTemplate}"
                                            Background="{DynamicResource ExportButtonBrush}"
                                            MinWidth="95"
                                            Padding="8,4"
                                            Command="{Binding ExportCsvCommand}"
                                            ToolTip="Сохранить текущий результат в CSV"/>
                                    <!-- Крупный просмотр: таблица открывается отдельным окном,
                                         ширины вкладки для широких таблиц Белстата не хватает. -->
                                    <Button Style="{StaticResource MainButton}"
                                            Content="Открыть в окне"
                                            ContentTemplate="{StaticResource IconViewTemplate}"
                                            Background="{DynamicResource SecondaryButtonBrush}"
                                            MinWidth="170"
                                            Padding="8,4"
                                            Command="{Binding OpenInNewWindowCommand}"
                                            ToolTip="Открыть таблицу результата в отдельном окне (крупный просмотр и экспорт)"/>
                                    <!-- Интерпретация статистики: разбор ряда показателя (тренд, аномалии,
                                         скачки, устойчивое изменение) и рекомендации в отдельном окне. -->
                                    <Button Style="{StaticResource AccentButton}"
                                            Content="Интерпретация"
                                            ContentTemplate="{StaticResource IconGraphTemplate}"
                                            MinWidth="180"
                                            Padding="8,4"
                                            Command="{Binding OpenInterpretationCommand}"
                                            ToolTip="Интерпретация статистических данных: тренд, аномалии, скачки «год к году» и рекомендации для следственной работы"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Индикатор загрузки и статус последнего действия -->
                        <StackPanel Grid.Row="3" Margin="0,10,0,4">
                            <ProgressBar Height="6"
                                         IsIndeterminate="{Binding IsLoading}"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextAccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Заголовок результата: показатель, период и объём выборки -->
                        <StackPanel Grid.Row="4" Margin="0,4,0,6">
                            <TextBlock Text="{Binding ResultTitle}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextAccentBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsResultVisible, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding ResultSubtitle}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsResultVisible, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding ResultRowCount, StringFormat='Строк в таблице: {0}'}"
                                       Visibility="{Binding IsResultVisible, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- Результат: таблица значений показателя.
                             Колонки строятся автоматически из DataTable (AutoGenerateColumns="True"),
                             а путь привязки переводится в индексную форму «[имя колонки]» в code-behind:
                             имена измерений Белстата содержат точки и пробелы, которые ломают
                             обычную привязку по имени колонки. -->
                        <Grid Grid.Row="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Фильтр таблицы показателя: отбор строк по любому измерению -->
                            <StackPanel Grid.Row="0"
                                        Style="{StaticResource TableFilterPanel}"
                                        Visibility="{Binding IsResultVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource TableFilterLabel}" Text="🔎 Фильтр:"/>
                                <TextBox x:Name="BelstatResultFilterBox" Style="{StaticResource TableFilterBox}"/>
                                <TextBlock Style="{StaticResource TableFilterHint}" Text="поиск по всем колонкам таблицы показателя"/>
                            </StackPanel>

                            <DataGrid x:Name="BelstatResultGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding ResultTable.DefaultView}"
                                      AutoGenerateColumns="True"
                                      AutoGeneratingColumn="BelstatDataGrid_AutoGeneratingColumn"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="Cell"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                                      ToolTip="Двойной клик по ячейке — копировать значение"
                                      Visibility="{Binding IsResultVisible, Converter={StaticResource BoolToVis}}"/>
                            <Border Grid.Row="1"
                                    Padding="16"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    Visibility="{Binding IsResultVisible, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding EmptyResultMessage}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Правая колонка: история выполненных запросов к API Белстата -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="10"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Background="{DynamicResource PanelBackgroundBrush}">
                            <StackPanel>
                                <TextBlock Text="История запросов статистики"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextAccentBrush}"/>
                                <TextBlock Text="Ранее выполненные запросы к API Белстата (локальная база данных приложения)"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,8,0,0"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Background="{DynamicResource CardBackgroundBrush}">
                            <!-- Двойной клик по записи (или пункт контекстного меню) восстанавливает
                                 показатель, рубрику и период из локальной базы данных приложения. -->
                            <ListBox x:Name="BelstatHistoryListBox"
                                     ItemsSource="{Binding HistoryItems}"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="BelstatHistoryListBox_MouseDoubleClick"
                                     ToolTip="Двойной клик — восстановить показатель и период из записи локальной БД; правый клик — операции с записью">
                                <ListBox.ContextMenu>
                                    <!-- Как и в меню истории УНП: доступ к ListBox идёт через
                                         PlacementTarget (ContextMenu живёт в Popup, x:Reference
                                         на владельца даёт циклическую зависимость). -->
                                    <ContextMenu>
                                        <MenuItem IsEnabled="False"
                                                  Header="{Binding Path=PlacementTarget.SelectedItem.Timestamp, RelativeSource={RelativeSource AncestorType=ContextMenu}, StringFormat=Запись от {0:dd.MM.yyyy HH:mm}}"/>
                                        <Separator/>
                                        <MenuItem Header="Загрузить из истории"
                                                  Command="{Binding Path=PlacementTarget.DataContext.LoadFromHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding Path=PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Обновить историю"
                                                  Command="{Binding Path=PlacementTarget.DataContext.RefreshHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,3">
                                            <TextBlock Text="{Binding IndicatorName}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextAccentBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding IndicatorName}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IndicatorCode}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Years}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Обновить"
                                    ContentTemplate="{StaticResource IconRefreshTemplate}"
                                    Style="{StaticResource MainButton}"
                                    Padding="12,6"
                                    Margin="0,0,8,0"
                                    Command="{Binding RefreshHistoryCommand}"
                                    ToolTip="Перечитать историю запросов из локальной базы"/>
                            <!-- Восстановление параметров запроса из локальной БД приложения
                                 (запись выбирается в списке истории, иначе — последняя выбранная). -->
                            <Button Content="Загрузить из истории"
                                    ContentTemplate="{StaticResource IconLoadTemplate}"
                                    Style="{StaticResource MainButton}"
                                    Background="{DynamicResource SecondaryButtonBrush}"
                                    Padding="12,6"
                                    Margin="0,0,8,0"
                                    Command="{Binding LoadFromHistoryCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=BelstatHistoryListBox}"
                                    ToolTip="Подставить показатель, рубрику и период из выбранной записи истории (значения загружаются кнопкой «Получить данные»)" Width="190"/>
                            <Button Content="Очистить"
                                    ContentTemplate="{StaticResource IconClearTemplate}"
                                    Style="{StaticResource MainButton}"
                                    Background="{DynamicResource DangerSoftBrush}"
                                    Padding="12,6"
                                    Command="{Binding ClearHistoryCommand}"
                                    ToolTip="Удалить все записи истории запросов" Width="173" Click="Button_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Футер: информация о разработчике -->
        <Border
                Height="1"
                Margin="0,10,0,0"
                Grid.Row="3" Background="{DynamicResource DividerBrush}" Grid.ColumnSpan="2"/>
        <TextBlock
                   Text="Разработчик: Климято Павел Викторович, Институт СК, КОЦРПС"
                   FontSize="10"
                   Foreground="{DynamicResource TextMutedBrush}"
                   HorizontalAlignment="Left"
                   Grid.Row="3" Margin="0,16,0,0" Grid.Column="1"/>
    </Grid>
</Window>
