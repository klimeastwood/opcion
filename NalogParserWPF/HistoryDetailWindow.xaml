<Window x:Class="NalogParserWPF.HistoryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:NalogParserWPF.ViewModels"
        xmlns:converters="clr-namespace:NalogParserWPF.Converters"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Детали записи из истории" 
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        MinHeight="500" MinWidth="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <converters:SearchTypeToRussianConverter x:Key="SearchTypeToRussianConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVis"/>

        <Style x:Key="MainButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="130"/>
        </Style>

        <Style x:Key="ExportButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{DynamicResource ExportButtonBrush}"/>
            <Setter Property="Content" Value="Экспорт в PDF"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconExportPdfTemplate}"/>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
            <Setter Property="Content" Value="Закрыть"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconCloseTemplate}"/>
        </Style>

        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
            <Setter Property="Content" Value="Копировать"/>
            <Setter Property="ContentTemplate" Value="{StaticResource IconCopyTemplate}"/>
            <Setter Property="MinWidth" Value="130"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>

        <Style x:Key="SectionBody" TargetType="Border">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>

        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка приложения с логотипом -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Source="sk-logo-2.png"
                   Width="56" Height="56"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Следственный комитет Республики Беларусь"
                           Style="{StaticResource AppTitleText}"/>
                <TextBlock Text="Проверка контрагентов по УНП"
                           Style="{StaticResource AppSubtitleText}"/>
            </StackPanel>
        </Grid>

        <!-- Заголовок -->
        <Border Grid.Row="1" 
                Background="{DynamicResource AccentBrush}" 
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,15">
            <Grid>
                <TextBlock FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource OnAccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <InlineUIContainer>
                        <iconPacks:PackIconBootstrapIcons Kind="ClipboardData" Width="20" Height="20" Margin="0,0,7,0"/>
                    </InlineUIContainer>
                    <Run Text="ПРОСМОТР ЗАПИСИ ИЗ ИСТОРИИ"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Информация о записи -->
        <Border Grid.Row="2" 
                Padding="10" 
                BorderBrush="{DynamicResource AccentBrush}" 
                BorderThickness="1" 
                CornerRadius="5"
                Background="{DynamicResource PanelBackgroundBrush}"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Дата:" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextAccentBrush}"
                           Margin="0,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" 
                           Text="{Binding CurrentEntry.SearchDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                           FontSize="14"
                           Foreground="{DynamicResource TextAccentBrush}"
                           Margin="0,0,15,5"/>

                <TextBlock Grid.Row="0" Grid.Column="2" 
                           Text="Тип:" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextAccentBrush}"
                           Margin="0,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="3" 
                           Text="{Binding CurrentEntry.SearchType, Converter={StaticResource SearchTypeToRussianConverter}}"
                           FontSize="14"
                           Foreground="{DynamicResource TextAccentBrush}"
                           Margin="0,0,15,5"/>

                <TextBlock Grid.Row="0" Grid.Column="4" 
                           Text="Статус:" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextAccentBrush}"
                           Margin="0,0,10,5"/>
                <TextBlock Grid.Row="0" Grid.Column="5" 
                           Text="{Binding CurrentEntry.Status}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{Binding CurrentEntry.Status, Converter={StaticResource StatusToBrushConverter}}"
                           Margin="0,0,0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="УНП:" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextAccentBrush}"
                           Margin="0,0,10,5"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding CurrentEntry.Unp}"
                           FontSize="14"
                           Foreground="{DynamicResource TextAccentBrush}"
                           Margin="0,0,15,5"/>

                <TextBlock Grid.Row="1" Grid.Column="2" 
                           Text="Наименование:" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextAccentBrush}"
                           Margin="0,0,10,5"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
                           Text="{Binding CurrentEntry.FullName}"
                           FontSize="14"
                           Foreground="{DynamicResource TextAccentBrush}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Детали -->
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Информация об обновлении -->
                    <Border Visibility="{Binding HasUpdateInfo, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource WarningBackgroundBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WarningTextBrush}"
                                       Margin="0,0,0,4">
                                <InlineUIContainer>
                                    <iconPacks:PackIconBootstrapIcons Kind="ArrowClockwise" Margin="0,0,4,0"/>
                                </InlineUIContainer>
                                <Run Text="Обновление"/>
                            </TextBlock>
                            <TextBlock Text="{Binding UpdateInfo}"
                                       Style="{StaticResource FieldValue}"
                                       Foreground="{DynamicResource WarningTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Основные поля -->
                    <Grid Visibility="{Binding HasCompanyData, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="227"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="УНП:" Style="{StaticResource FieldLabel}" Height="19" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Unp}" Style="{StaticResource FieldValue}" Height="19"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Полное наименование:" Style="{StaticResource FieldLabel}" Height="18" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FullName}" Style="{StaticResource FieldValue}" Height="18"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Краткое наименование:" Style="{StaticResource FieldLabel}" Height="19" Margin="0,26,10,0" Grid.RowSpan="2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ShortName}" Style="{StaticResource FieldValue}" Height="19" Margin="0,26,0,0" Grid.RowSpan="2"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Адрес:" Style="{StaticResource FieldLabel}" Height="18" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Address}" Style="{StaticResource FieldValue}" Height="18"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата регистрации:" Style="{StaticResource FieldLabel}" Height="19" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RegistrationDate}" Style="{StaticResource FieldValue}" Height="19"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Инспекция МНС:" Style="{StaticResource FieldLabel}" Height="19" Margin="0,4,10,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldValue}" Height="19" Margin="0,4,0,0">
                            <Run Text="{Binding InspectionName, Mode=OneWay}"/>
                            <Run Text=" (код "/>
                            <Run Text="{Binding InspectionCode, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Статус:" Style="{StaticResource FieldLabel}" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,9">
                            <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                    Visibility="{Binding Status, Converter={StaticResource EmptyStringToVis}}"
                                    CornerRadius="3"
                                    Padding="12,4"
                                    Margin="0,0,8,8">
                                <TextBlock Text="{Binding Status}"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                            </Border>
                            <TextBlock Text="{Binding StatusCode}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,8"/>
                        </StackPanel>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Дата изменения статуса:" Style="{StaticResource FieldLabel}" Height="19" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Height="19">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldValue}">
                                    <Setter Property="Text" Value="{Binding StatusChangeDate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStatusChangeDate}" Value="False">
                                            <Setter Property="Text" Value="—"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Дата ликвидации:" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Height="19">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldValue}">
                                    <Setter Property="Text" Value="{Binding LiquidationDate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLiquidationDate}" Value="False">
                                            <Setter Property="Text" Value="—"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- История наименований -->
                    <TextBlock Style="{StaticResource SectionHeader}"><InlineUIContainer><iconPacks:PackIconBootstrapIcons Kind="PinAngle" Margin="0,0,4,0"/></InlineUIContainer><Run Text="История наименований"/></TextBlock>
                    <Border Style="{StaticResource SectionBody}">
                        <TextBlock Text="{Binding NamesHistoryMessage}" Style="{StaticResource PlaceholderText}"/>
                    </Border>

                    <!-- История адресов -->
                    <TextBlock Style="{StaticResource SectionHeader}"><InlineUIContainer><iconPacks:PackIconBootstrapIcons Kind="GeoAlt" Margin="0,0,4,0"/></InlineUIContainer><Run Text="История адресов"/></TextBlock>
                    <Border Style="{StaticResource SectionBody}">
                        <TextBlock Text="{Binding AddressesHistoryMessage}" Style="{StaticResource PlaceholderText}"/>
                    </Border>

                    <!-- История видов деятельности -->
                    <TextBlock Style="{StaticResource SectionHeader}"><InlineUIContainer><iconPacks:PackIconBootstrapIcons Kind="BarChart" Margin="0,0,4,0"/></InlineUIContainer><Run Text="История видов деятельности"/></TextBlock>
                    <Border Style="{StaticResource SectionBody}">
                        <TextBlock Text="{Binding ActivitiesHistoryMessage}" Style="{StaticResource PlaceholderText}"/>
                    </Border>

                    <!-- Контакты -->
                    <TextBlock Style="{StaticResource SectionHeader}"><InlineUIContainer><iconPacks:PackIconBootstrapIcons Kind="Telephone" Margin="0,0,4,0"/></InlineUIContainer><Run Text="Контакты"/></TextBlock>
                    <Border Style="{StaticResource SectionBody}" Margin="0,0,0,10">
                        <TextBlock Text="{Binding ContactsMessage}" Style="{StaticResource PlaceholderText}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btnExportPdf"
                    Style="{StaticResource ExportButton}"
                    Command="{Binding ExportPdfCommand}"/>

            <Button x:Name="btnCopy"
                    Style="{StaticResource CopyButton}"
                    Command="{Binding CopyResultCommand}"/>

            <Button x:Name="btnClose"
                    Style="{StaticResource CloseButton}"
                    Command="{Binding CloseCommand}"/>

            <TextBlock Text="(или нажмите Esc для закрытия)"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
